ENVIRONMENT=development
DEBUG=false

# postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/alur_logistik

# Minimal 32 karakter. Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-change-me-change-me-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Format JSON list
CORS_ORIGINS=["http://localhost:5173"]

BUSINESS_TIMEZONE=Asia/Jakarta
UPLOAD_DIR=uploads
SCHEDULER_ENABLED=true
